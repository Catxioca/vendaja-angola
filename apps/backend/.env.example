NODE_ENV=development
DATABASE_URL=postgresql://local_app_user:<generate-a-local-password>@localhost:5432/angola_commerce
JWT_SECRET=<generate-at-least-32-random-characters>
FISCAL_CONFIG_KEY=<generate-a-different-at-least-32-character-secret>
PORT=4000
COMPANY_NIF=000000000
COMPANY_NAME=Empresa de Demonstração
CORS_ORIGIN=http://localhost:5173
FISCAL_PRIVATE_KEY=
SAFT_AO_XSD_PATH=

# Optional initial administrator seed values. Never commit real values.
ADMIN_INITIAL_EMAIL=admin@example.invalid
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_NAME=Administrador
ADMIN_INITIAL_PASSWORD=<set-only-in-local-secret-store>
ADMIN_INITIAL_PIN=<4-to-6-digit-pin>
