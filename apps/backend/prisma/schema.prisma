generator client {
  provider = "prisma-client-js"
}

model DocumentSeries {
  id String @id @default(uuid())
  companyKey String
  establishmentKey String
  documentType String
  prefix String
  nextNumber Int @default(1)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  documents CommercialDocument[]
  @@unique([companyKey, establishmentKey, documentType, prefix])
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model ProcurementRequest {
  id String @id @default(uuid())
  number String @unique
  status String @default("DRAFT")
  requestedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lines ProcurementRequestLine[]
  quotations SupplierQuotation[]
}

model ProcurementRequestLine {
  id String @id @default(uuid())
  requestId String
  productId String
  quantity Int
  request ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model SupplierQuotation {
  id String @id @default(uuid())
  number String @unique
  requestId String?
  supplierId String
  status String @default("RECEIVED")
  createdAt DateTime @default(now())
  request ProcurementRequest? @relation(fields: [requestId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])
  lines SupplierQuotationLine[]
  orders ProcurementOrder[]
}

model SupplierQuotationLine {
  id String @id @default(uuid())
  quotationId String
  productId String
  quantity Int
  unitCostCents Int
  quotation SupplierQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model ProcurementOrder {
  id String @id @default(uuid())
  number String @unique
  quotationId String?
  supplierId String
  status String @default("OPEN")
  createdAt DateTime @default(now())
  quotation SupplierQuotation? @relation(fields: [quotationId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])
  lines ProcurementOrderLine[]
  purchases Purchase[]
}

model ProcurementOrderLine {
  id String @id @default(uuid())
  orderId String
  productId String
  quantity Int
  unitCostCents Int
  order ProcurementOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}
model User {
  id String @id @default(uuid())
  email String @unique
  username String? @unique
  displayName String?
  nif String?
  phone String?
  passwordHash String
  pinHash String?
  role String @default("ROLE_CASHIER")
  refreshTokens RefreshToken[]
  auditLogs AuditLog[]
  sales Sale[] @relation("SaleOperator")
  receivablePayments ReceivablePayment[]
  stockMovements StockMovement[]
  purchases Purchase[]
  stockTransfers StockTransfer[] @relation("TransferOperator")
  inventoryCounts InventoryCount[] @relation("InventoryOperator")
  purchaseReceipts PurchaseReceipt[]
  expenses Expense[]
  payablePayments PayablePayment[]
  createdAt DateTime @default(now())
  memberships CompanyMembership[]
}

model Company {
  id String @id @default(uuid())
  legalName String
  nif String? @unique
  active Boolean @default(true)
  branches Branch[]
  memberships CompanyMembership[]
  warehouses Warehouse[]
  cashRegisters CashRegister[]
  bankAccounts BankAccount[]
  paymentTerminals PaymentTerminal[]
  createdAt DateTime @default(now())
}

model Branch {
  id String @id @default(uuid())
  companyId String
  code String
  name String
  active Boolean @default(true)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships CompanyMembership[]
  warehouses Warehouse[]
  cashRegisters CashRegister[]
  @@unique([companyId, code])
}

model CompanyMembership {
  id String @id @default(uuid())
  userId String
  companyId String
  branchId String?
  role String
  modules String[] @default([])
  active Boolean @default(true)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@unique([userId, companyId, branchId])
  @@index([companyId, branchId, active])
}

model CashRegister {
  id String @id @default(uuid())
  companyId String
  branchId String
  code String
  name String
  active Boolean @default(true)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shifts PosShift[]
  @@unique([branchId, code])
}

model PosShift {
  id String @id @default(uuid())
  cashRegisterId String
  operatorId String
  openedAt DateTime @default(now())
  openingCents Int
  closedAt DateTime?
  closingCents Int?
  declaredCents Int?
  differenceCents Int?
  status String @default("OPEN")
  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  @@index([cashRegisterId, status])
}

model BankAccount {
  id String @id @default(uuid())
  companyId String
  branchId String?
  name String
  iban String?
  currency String @default("AOA")
  openingBalanceCents Int @default(0)
  active Boolean @default(true)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  statements BankStatement[]
  @@unique([companyId, iban])
}

model BankStatement {
  id String @id @default(uuid())
  bankAccountId String
  referenceHash String @unique
  statementDate DateTime
  openingBalanceCents Int
  closingBalanceCents Int
  importedAt DateTime @default(now())
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  lines BankStatementLine[]
}

model BankStatementLine {
  id String @id @default(uuid())
  statementId String
  lineHash String @unique
  occurredAt DateTime
  description String
  amountCents Int
  reconciledAt DateTime?
  reconciledBy String?
  statement BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
}

model PaymentTerminal {
  id String @id @default(uuid())
  companyId String
  branchId String?
  code String
  provider String
  config Json?
  active Boolean @default(true)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]
  @@unique([companyId, code])
}

model PaymentTransaction {
  id String @id @default(uuid())
  terminalId String
  idempotencyKey String @unique
  externalReference String?
  amountCents Int
  status String @default("PENDING")
  operation String @default("SALE")
  createdAt DateTime @default(now())
  terminal PaymentTerminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  @@index([terminalId, createdAt])
}

model ReprintLog {
  id String @id @default(uuid())
  companyId String
  branchId String?
  documentType String
  documentId String
  reason String
  userId String
  createdAt DateTime @default(now())
  @@index([companyId, documentType, documentId])
}
model Product {
  id String @id @default(uuid())
  sku String @unique
  name String
  priceCents Int
  stock Int @default(0)
  minStock Int @default(0)
  maxStock Int?
  reorderQuantity Int @default(0)
  trackingMode String @default("NONE")
  taxRate Decimal @db.Decimal(5,4)
  active Boolean @default(true)
  updatedAt DateTime @updatedAt
  saleLines SaleLine[]
  taxCategory String @default("GENERAL")
  exemptionCode String?
  costCents Int @default(0)
  barcode String? @unique
  qrCode String? @unique
  imageUrl String?
  brand String?
  model String?
  supplierId String?
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  categoryId String?
  category Category? @relation(fields: [categoryId], references: [id])
  stockMovements StockMovement[]
  purchaseLines PurchaseLine[]
  stockBalances StockBalance[]
  supplierPrices SupplierProductPrice[]
  purchaseReceiptLines PurchaseReceiptLine[]
  commercialDocumentLines CommercialDocumentLine[]
  transferLines StockTransferLine[]
  inventoryCountLines InventoryCountLine[]
  lots StockLot[]
  procurementRequestLines ProcurementRequestLine[]
  quotationLines SupplierQuotationLine[]
  procurementOrderLines ProcurementOrderLine[]
}
model Category {
  id String @id @default(uuid())
  name String @unique
  products Product[]
}
model FiscalExemption {
  code String @id
  reason String
  active Boolean @default(true)
}
model Sale {
  id String @id
  number String @unique
  subtotalCents Int
  taxCents Int
  totalCents Int
  currency String @default("AOA")
  createdAt DateTime @default(now())
  lines SaleLine[]
  syncMutations SyncMutation[]
  status String @default("COMPLETED")
  fiscalType String @default("INVOICE_RECEIPT")
  series String @default("A")
  fiscalHash String?
  fiscalSignature String?
  signatureAlgorithm String?
  qrCode String?
  customerNif String?
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id])
  paymentMethod String @default("CASH")
  dueDate DateTime?
  cancelledAt DateTime?
  cancelledBy String?
  operatorId String?
  operator User? @relation("SaleOperator", fields: [operatorId], references: [id])
  cashSessionId String?
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id])
  cashCents Int @default(0)
  cardCents Int @default(0)
  transferCents Int @default(0)
  operatorName String?
  operatorNif String?
  operatorPhone String?
  terminalId String?
}

model Customer {
  id String @id @default(uuid())
  nif String? @unique
  name String
  email String?
  phone String?
  address String?
  sales Sale[]
  receivablePayments ReceivablePayment[]
  active Boolean @default(true)
  creditLimitCents Int @default(0)
  outstandingDebtCents Int @default(0)
  commercialDocuments CommercialDocument[]
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model ReceivablePayment {
  id String @id @default(uuid())
  customerId String
  amountCents Int
  paymentMethod String @default("CASH")
  idempotencyKey String @unique
  cashSessionId String?
  operatorId String?
  note String?
  reference String?
  receivedAt DateTime @default(now())
  customer Customer @relation(fields: [customerId], references: [id])
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id])
  operator User? @relation(fields: [operatorId], references: [id])
  @@index([customerId, receivedAt])
}

model FiscalConfig {
  id String @id @default("default")
  certificatePfxEncrypted String?
  privateKeyPemEncrypted String?
  passphraseEncrypted String?
  licenseEncrypted String?
  companyName String?
  companyNif String?
  companyAddress String?
  companyProvince String?
  companyPhone String?
  saftSchedule String?
  invoiceSeries String @default("A")
  saftLastExportAt DateTime?
  updatedAt DateTime @updatedAt
}

model Supplier {
  id String @id @default(uuid())
  name String
  nif String? @unique
  email String?
  phone String?
  address String?
  contactName String?
  notes String?
  code String? @unique
  active Boolean @default(true)
  products Product[]
  purchases Purchase[]
  payables AccountPayable[]
  expenses Expense[]
  supplierPrices SupplierProductPrice[]
  commercialDocuments CommercialDocument[]
  supplierQuotations SupplierQuotation[]
  procurementOrders ProcurementOrder[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id String @id @default(uuid())
  description String
  category String
  supplierId String?
  documentNumber String?
  amountCents Int
  expenseDate DateTime @default(now())
  paymentMethod String @default("CASH")
  notes String?
  status String @default("ACTIVE")
  operatorId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  operator User? @relation(fields: [operatorId], references: [id])
  @@index([expenseDate, status])
  @@index([category, expenseDate])
  @@index([supplierId, expenseDate])
}

model Purchase {
  id String @id @default(uuid())
  number String @unique
  supplierId String
  operatorId String?
  status String @default("DRAFT")
  paymentMethod String @default("CASH")
  subtotalCents Int
  discountCents Int @default(0)
  taxCents Int @default(0)
  totalCents Int
  documentNumber String?
  purchasedAt DateTime @default(now())
  confirmedAt DateTime?
  notes String?
  idempotencyKey String @unique
  supplier Supplier @relation(fields: [supplierId], references: [id])
  operator User? @relation(fields: [operatorId], references: [id])
  lines PurchaseLine[]
  payable AccountPayable?
  receipts PurchaseReceipt[]
  @@index([supplierId, purchasedAt])
  procurementOrderId String?
  procurementOrder ProcurementOrder? @relation(fields: [procurementOrderId], references: [id])
}

model PurchaseLine {
  id String @id @default(uuid())
  purchaseId String
  productId String
  quantity Int
  unitCostCents Int
  taxRate Decimal @db.Decimal(5,4)
  totalCents Int
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  @@index([purchaseId])
}

model AccountPayable {
  id String @id @default(uuid())
  purchaseId String @unique
  supplierId String
  originalCents Int
  paidCents Int @default(0)
  dueDate DateTime
  status String @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchase Purchase @relation(fields: [purchaseId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])
  payments PayablePayment[]
  @@index([supplierId, status])
}

model PayablePayment {
  id String @id @default(uuid())
  payableId String
  amountCents Int
  paymentMethod String @default("TRANSFER")
  idempotencyKey String @unique
  reference String?
  note String?
  paidAt DateTime @default(now())
  operatorId String?
  payable AccountPayable @relation(fields: [payableId], references: [id])
  operator User? @relation(fields: [operatorId], references: [id])
  @@index([payableId, paidAt])
}

model StockMovement {
  id String @id @default(uuid())
  productId String
  quantity Int
  type String
  reference String?
  note String?
  occurredAt DateTime @default(now())
  supplierId String?
  operatorId String?
  locationId String?
  lotId String?
  product Product @relation(fields: [productId], references: [id])
  operator User? @relation(fields: [operatorId], references: [id])
  location StockLocation? @relation(fields: [locationId], references: [id])
  lot StockLot? @relation(fields: [lotId], references: [id])
  @@index([productId, occurredAt])
}

model Warehouse {
  id String @id @default(uuid())
  companyId String?
  branchId String?
  code String @unique
  name String
  active Boolean @default(true)
  locations StockLocation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  @@index([companyId, branchId])
}

model StockLocation {
  id String @id @default(uuid())
  warehouseId String
  code String
  name String
  active Boolean @default(true)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  balances StockBalance[]
  sourceTransfers StockTransfer[] @relation("TransferSource")
  destinationTransfers StockTransfer[] @relation("TransferDestination")
  inventoryCounts InventoryCount[]
  lots StockLot[]
  movements StockMovement[]
  commercialDocuments CommercialDocument[]
  @@unique([warehouseId, code])
}

model StockBalance {
  id String @id @default(uuid())
  productId String
  locationId String
  quantity Int @default(0)
  averageCostCents Int @default(0)
  totalCostCents Int @default(0)
  updatedAt DateTime @updatedAt
  product Product @relation(fields: [productId], references: [id])
  location StockLocation @relation(fields: [locationId], references: [id])
  @@unique([productId, locationId])
  @@index([locationId, quantity])
}

model StockLot {
  id String @id @default(uuid())
  productId String
  locationId String
  lotNumber String?
  serialNumber String?
  expiresAt DateTime?
  quantity Int @default(0)
  unitCostCents Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product Product @relation(fields: [productId], references: [id])
  location StockLocation @relation(fields: [locationId], references: [id])
  movements StockMovement[]
  @@unique([productId, locationId, lotNumber, serialNumber])
  @@index([productId, expiresAt])
}

model StockTransfer {
  id String @id @default(uuid())
  sourceLocationId String
  destinationLocationId String
  reference String @unique
  status String @default("COMPLETED")
  operatorId String?
  createdAt DateTime @default(now())
  sourceLocation StockLocation @relation("TransferSource", fields: [sourceLocationId], references: [id])
  destinationLocation StockLocation @relation("TransferDestination", fields: [destinationLocationId], references: [id])
  operator User? @relation("TransferOperator", fields: [operatorId], references: [id])
  lines StockTransferLine[]
  @@index([createdAt])
}

model StockTransferLine {
  id String @id @default(uuid())
  transferId String
  productId String
  quantity Int
  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  @@index([transferId])
}

model InventoryCount {
  id String @id @default(uuid())
  locationId String
  status String @default("DRAFT")
  reference String @unique
  operatorId String?
  countedAt DateTime?
  createdAt DateTime @default(now())
  location StockLocation @relation(fields: [locationId], references: [id])
  operator User? @relation("InventoryOperator", fields: [operatorId], references: [id])
  lines InventoryCountLine[]
}

model InventoryCountLine {
  id String @id @default(uuid())
  inventoryCountId String
  productId String
  expectedQuantity Int
  countedQuantity Int
  inventoryCount InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  @@unique([inventoryCountId, productId])
}

model SupplierProductPrice {
  id String @id @default(uuid())
  supplierId String
  productId String
  unitCostCents Int
  validFrom DateTime @default(now())
  validTo DateTime?
  supplier Supplier @relation(fields: [supplierId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  @@index([supplierId, productId, validFrom])
}

model PurchaseReceipt {
  id String @id @default(uuid())
  purchaseId String
  reference String @unique
  receivedAt DateTime @default(now())
  operatorId String?
  purchase Purchase @relation(fields: [purchaseId], references: [id])
  operator User? @relation(fields: [operatorId], references: [id])
  lines PurchaseReceiptLine[]
  @@index([purchaseId, receivedAt])
}

model PurchaseReceiptLine {
  id String @id @default(uuid())
  receiptId String
  productId String
  quantity Int
  receipt PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model CommercialDocument {
  id String @id @default(uuid())
  type String
  status String @default("DRAFT")
  series String
  number String
  customerId String?
  supplierId String?
  locationId String?
  seriesId String?
  sourceId String?
  subtotalCents Int @default(0)
  discountCents Int @default(0)
  taxCents Int @default(0)
  totalCents Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer? @relation(fields: [customerId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  location StockLocation? @relation(fields: [locationId], references: [id])
  seriesConfig DocumentSeries? @relation(fields: [seriesId], references: [id])
  lines CommercialDocumentLine[]
  @@unique([type, series, number])
  @@index([type, createdAt])
}

model CommercialDocumentLine {
  id String @id @default(uuid())
  documentId String
  productId String
  quantity Int
  unitPriceCents Int
  discountCents Int @default(0)
  taxRate Decimal @db.Decimal(5,4)
  totalCents Int
  document CommercialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model RefreshToken {
  id String @id @default(uuid())
  tokenHash String @unique
  userId String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  @@index([userId, expiresAt])
}

model AuditLog {
  id String @id @default(uuid())
  action String
  entity String?
  entityId String?
  userId String?
  metadata Json?
  createdAt DateTime @default(now())
  companyId String?
  branchId String?
  user User? @relation(fields: [userId], references: [id])
  @@index([createdAt])
}

model FiscalSequence {
  id String @id @default(uuid())
  documentType String
  series String
  nextNumber Int @default(1)
  @@unique([documentType, series])
}

model CashSession {
  id String @id @default(uuid())
  openedBy String
  openedAt DateTime @default(now())
  openingCents Int
  closedBy String?
  closedAt DateTime?
  closingCents Int?
  sangriaCents Int @default(0)
  suprimentoCents Int @default(0)
  operatorName String?
  operatorNif String?
  operatorPhone String?
  terminalId String?
  sales Sale[]
  receivablePayments ReceivablePayment[]
}

model Employee {
  id String @id @default(uuid())
  fullName String
  nif String? @unique
  inss String? @unique
  position String
  department String?
  contractType String @default("FIXED")
  iban String?
  baseSalaryCents Int
  foodAllowanceCents Int @default(0)
  transportAllowanceCents Int @default(0)
  housingAllowanceCents Int @default(0)
  otherAllowancesCents Int @default(0)
  foodAllowanceExempt Boolean @default(true)
  transportAllowanceExempt Boolean @default(true)
  housingAllowanceExempt Boolean @default(false)
  otherAllowancesExempt Boolean @default(false)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payrolls Payroll[]
}

model Payroll {
  id String @id @default(uuid())
  employeeId String
  month String
  salaryBaseCents Int
  foodAllowanceCents Int @default(0)
  transportAllowanceCents Int @default(0)
  housingAllowanceCents Int @default(0)
  otherAllowancesCents Int @default(0)
  taxableAllowancesCents Int @default(0)
  grossSalaryCents Int
  irtCents Int @default(0)
  inssEmployeeCents Int @default(0)
  inssEmployerCents Int @default(0)
  netSalaryCents Int
  payDate DateTime?
  status String @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employee Employee @relation(fields: [employeeId], references: [id])
  @@unique([employeeId, month])
}

model Account {
  id String @id @default(uuid())
  code String @unique
  name String
  type String
  category String?
  parentCode String?
  createdAt DateTime @default(now())
  debitEntries JournalEntry[] @relation("DebitAccount")
  creditEntries JournalEntry[] @relation("CreditAccount")
  journalLines JournalLine[]
  outputTaxRules TaxRule[] @relation("TaxOutputAccount")
  inputTaxRules TaxRule[] @relation("TaxInputAccount")
}

model JournalEntry {
  id String @id @default(uuid())
  description String
  entryDate DateTime @default(now())
  debitAccountId String
  creditAccountId String
  amountCents Int
  sourceType String?
  sourceId String?
  journalType String @default("GENERAL")
  documentType String @default("MANUAL")
  documentNumber String?
  createdBy String?
  createdAt DateTime @default(now())
  debitAccount Account @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccount Account @relation("CreditAccount", fields: [creditAccountId], references: [id])
}

model Journal {
  id String @id @default(uuid())
  description String
  entryDate DateTime @default(now())
  journalType String @default("GENERAL")
  documentType String @default("MANUAL")
  documentNumber String?
  sourceType String?
  sourceId String?
  createdBy String?
  createdAt DateTime @default(now())
  status String @default("POSTED")
  periodId String?
  period AccountingPeriod? @relation(fields: [periodId], references: [id])
  lines JournalLine[]
  @@index([entryDate])
  @@index([periodId])
  @@unique([sourceType, sourceId])
}

model AccountingPeriod {
  id String @id @default(uuid())
  name String
  startsAt DateTime
  endsAt DateTime
  status String @default("OPEN")
  closedAt DateTime?
  closedBy String?
  journals Journal[]
  createdAt DateTime @default(now())
  @@unique([startsAt, endsAt])
  @@index([status, startsAt, endsAt])
}

model TaxRule {
  id String @id @default(uuid())
  code String @unique
  name String
  rate Decimal @db.Decimal(5,4)
  exemptionCode String?
  outputAccountId String?
  inputAccountId String?
  active Boolean @default(true)
  outputAccount Account? @relation("TaxOutputAccount", fields: [outputAccountId], references: [id])
  inputAccount Account? @relation("TaxInputAccount", fields: [inputAccountId], references: [id])
  createdAt DateTime @default(now())
}

model JournalLine {
  id String @id @default(uuid())
  journalId String
  accountId String
  description String?
  debitCents Int @default(0)
  creditCents Int @default(0)
  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])
  @@index([accountId])
  @@index([journalId])
}

model SaleLine {
  id String @id @default(uuid())
  saleId String
  productId String
  quantity Int
  unitPriceCents Int
  taxRate Decimal @db.Decimal(5,4)
  sale Sale @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  @@index([saleId])
}

model SyncMutation {
  id String @id
  deviceId String
  entity String
  operation String
  occurredAt DateTime
  saleId String?
  sale Sale? @relation(fields: [saleId], references: [id])
  createdAt DateTime @default(now())
  companyId String?
  branchId String?
  userId String?
  @@index([deviceId, occurredAt])
  @@index([companyId, branchId, userId])
}
