{
  "name": "angola-commerce-platform",
  "version": "2.2.0",
  "private": true,
  "description": "Hybrid Angola commerce, invoicing and point-of-sale platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "dev:backend": "npm --workspace @angola/backend run dev",
    "dev:web": "npm --workspace @angola/web run dev",
    "dev:desktop": "npm --workspace @angola/desktop run dev",
    "build:web": "npm --workspace @angola/web run build",
    "build:desktop": "npm --workspace @angola/desktop run build",
    "cap:sync": "npx cap sync",
    "cap:sync:android": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "android:assemble": "npm run cap:sync:android && gradlew.bat -p android assembleRelease",
    "android:bundle": "npm run cap:sync:android && gradlew.bat -p android bundleRelease",
    "ios:open": "npm run cap:sync:ios && npx cap open ios",
    "desktop:dist": "npm run build:desktop && electron-builder --win nsis --linux deb --mac dmg",
    "db:generate": "npm --workspace @angola/backend run prisma:generate",
    "db:migrate": "npm --workspace @angola/backend run prisma:migrate",
    "db:seed": "npm --workspace @angola/backend run db:seed"
    ,"generate-license": "node scripts/generate-license.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@capacitor-community/sqlite": "^7.0.3",
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
